# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and never committed.

# Google OAuth 2.0 client ID from Google Cloud Console
# https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com

# Set to true to use local data/ directory instead of Google Drive.
# Tracks are served from data/tracks/, peaks from data/peaks/.
# No sign-in required. Index is cached in localStorage.
VITE_LOCAL_MODE=false

# Optional: name of a subfolder in My Drive to use as the app root.
# Leave blank to use My Drive directly.
# VITE_DRIVE_FOLDER=DoneIt
